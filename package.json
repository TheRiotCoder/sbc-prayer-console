{
  "name": "sbc-prayer-worker",
  "version": "0.1.0",
  "description": "Missionary Status & Prayer Console (SBC-focused) as a Cloudflare Worker (free tier): Workers static assets + KV + Cron Trigger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:data": "node scripts/build-countries.mjs",
    "check": "node --check src/index.js && node --check public/app.js",
    "test": "node --test test/*.test.js",
    "bundle:test": "esbuild test/bundle-entry.js --bundle --platform=node --format=esm --outfile=test/bundle.mjs --log-level=warning",
    "pretest": "npm run bundle:test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "license": "UNLICENSED"
}
